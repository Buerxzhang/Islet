<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.codex.compact-speed-bar.fanhelper</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/local.codex.compact-speed-bar.fanhelper</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>local.codex.compact-speed-bar.fanhelper</key>
		<true/>
	</dict>
	<!-- 常驻：启动时先把风扇交还系统，异常退出后 launchd 会重新拉起它再清理一次 -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
